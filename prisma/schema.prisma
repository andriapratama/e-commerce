// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model Category {
  id              String @id @default(uuid())
  name            String @unique
  slug            String @unique

  subCategories   SubCategory[] @relation("CategoryToSubCategory")
  products        Product[] @relation("CategoryToProduct")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SubCategory {
  id            String @id @default(uuid())
  name          String @unique
  slug          String @unique

  categoryId    String
  category      Category @relation("CategoryToSubCategory", fields: [categoryId], references: [id])

  products      Product[] @relation("SubCategoryToProduct")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
}

model Employee {
  id        String @id @default(uuid())
  name      String
  username  String @unique
  password  String
  role      RoleEmployee

  productFinanceLog ProductFinanceLog[] @relation("EmployeeToProductFinanceLog")
  productStockLog   ProductStockLog[] @relation("EmployeeToProductStockLog")
  productStatusLog  ProductStatusLog[] @relation("EmployeeToProductStatusLog")
  order             Order[] @relation("EmployeeToOrder")
  orderLog          OrderLog[] @relation("EmployeeToOrderLog")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RoleEmployee {
  superAdmin
  admin
}

model User {
  id        String @id @default(uuid())
  firstName  String
  lastName  String
  email     String @unique
  password  String
  role      RoleUser
  address   String? @db.Text
  phone     String?
  active    Boolean @default(false)

  activateToken ActivateToken[] @relation("UserToActivateToken")
  cart          Cart[] @relation("UserToCart")
  order         Order[] @relation("UserToOrder")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RoleUser {
  member
  guest
}

model ActivateToken {
  id          String @id @default(uuid())
  token       String @unique
  activateAt  DateTime?

  userId      String
  user        User @relation("UserToActivateToken", fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Product {
  id              String @id @default(uuid())
  name            String @unique
  slug            String @unique
  totalStock      Int @db.SmallInt
  minimumStock    Int @db.SmallInt
  price           Int
  cost            Int
  netFill         Int @db.SmallInt
  status          StatusProduct 
  linkGojek       String?
  description     String? @db.Text
  image           String
  imagePathname   String
  salePrice       Int @default(0)

  categoryId      String
  category        Category @relation("CategoryToProduct", fields: [categoryId], references: [id])
  subCategoryId   String?
  subCategory     SubCategory? @relation("SubCategoryToProduct", fields: [subCategoryId], references: [id])

  productFinanceLog   ProductFinanceLog[] @relation("ProductToProductFinanceLog")
  productStockLog     ProductStockLog[] @relation("ProductToProductStockLog")
  productStatusLog    ProductStatusLog[] @relation("ProductToProductStatusLog")
  orderDetail         OrderDetail[] @relation("ProductToOrderDetail")
  cart                Cart[] @relation("ProductToCart")
  promoProductProvision PromoProductProvision[] @relation("ProductToPromoProductProvision")
  promoProductBonus PromoProductBonus[] @relation("ProductToPromoProductBonus")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
  @@index([subCategoryId])
  @@fulltext([name])
}

enum StatusProduct {
  new
  active
  best
  sale
  archive
}

model ProductFinanceLog {
  id      String @id @default(uuid())
  price   Int
  cost    Int
  note    String?

  productId   String
  product     Product @relation("ProductToProductFinanceLog", fields: [productId], references: [id])
  employeeId  String
  employee    Employee @relation("EmployeeToProductFinanceLog", fields: [employeeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([employeeId])
}

model ProductStockLog {
  id              String @id @default(uuid())
  previousStock   Int
  stock           Int
  stockNow        Int
  status          StatusStock
  note            String?

  order           String?
  productId       String
  product         Product @relation("ProductToProductStockLog", fields: [productId], references: [id])
  employeeId      String
  employee        Employee @relation("EmployeeToProductStockLog", fields: [employeeId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([employeeId])
}

enum StatusStock {
  first
  update
  decrease
  increase
}

model ProductStatusLog {
  id          String @id @default(uuid())
  status      StatusProduct
  salePrice   Int @default(0)
  note        String?

  productId   String
  product     Product @relation("ProductToProductStatusLog", fields: [productId], references: [id])
  employeeId  String
  employee    Employee @relation("EmployeeToProductStatusLog", fields: [employeeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([employeeId])
}

model Cart {
  id          String @id @default(uuid())
  quantity    Int @db.SmallInt
  total       Int
  status      Boolean @default(false)

  productId   String
  product     Product @relation("ProductToCart", fields: [productId], references: [id])
  userId      String
  user        User @relation("UserToCart", fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model Order {
  id              String @id @default(uuid())
  invoice         String @unique
  statusOrder     StatusOrder
  paymentMethod   PaymentMethod
  statuspayment   StatusPayment
  totalItem       Int
  subTotal        Int?
  shipping        Int? @default(0)
  grandTotal      Int?
  discount        Int? @default(0)
  tax             Int?
  note            String? @db.Text

  userName        String
  userEmail       String
  userPhone       String

  employeeName    String?

  userId          String
  user            User @relation("UserToOrder", fields: [userId], references: [id])
  employeeId      String?
  employee        Employee? @relation("EmployeeToOrder", fields: [employeeId], references: [id])

  orderDetail     OrderDetail[] @relation("OrderToOrderDetail")
  orderLog        OrderLog[] @relation("OrderToOrderLog")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([employeeId])
}

model OrderDetail {
  id          String @id @default(uuid())
  name        String
  price       Int
  quantity    Int @db.TinyInt
  total       Int

  orderId     String
  order       Order @relation("OrderToOrderDetail", fields: [orderId], references: [id])
  productId   String
  product     Product @relation("ProductToOrderDetail", fields: [productId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([orderId])
}

model OrderLog {
  id            String @id @default(uuid())
  status        StatusOrderLog

  employeeName  String?

  orderId       String
  order         Order @relation("OrderToOrderLog", fields: [orderId], references: [id])
  employeeId    String?
  employee      Employee? @relation("EmployeeToOrderLog", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([employeeId])
}

enum PaymentMethod {
  cash
  transfer
}

enum StatusOrder {
  new
  ongoing
  done
  cancel
}

enum StatusPayment {
  pending
  paid
}

enum StatusOrderLog {
  new
  open
  invoice
  paid
  delivery
  accepted
  done
  cancel
}

model Hero {
  id              String @id @default(uuid())
  image           String
  imagePathname   String
  position        Int @db.SmallInt

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Promo {
  id              String @id @default(uuid())
  image           String
  imagePathname   String
  name            String @unique
  slug            String @unique
  description     String @db.Text
  firstPrice       Int
  promoPrice      Int
  status          PromoStatus

  promoProductProvision   PromoProductProvision[] @relation("PromoToPromoProductProvision")
  promoProductBonus       PromoProductBonus[] @relation("PromoToPromoProductBonus")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PromoProductProvision {
  id              String @id @default(uuid())
  name            String
  price           Int
  quantity        Int
  subTotal        Int

  promoId         String
  promo           Promo @relation("PromoToPromoProductProvision", fields: [promoId], references: [id])
  productId       String
  product         Product @relation("ProductToPromoProductProvision", fields: [productId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([promoId])
  @@index([productId])
}

model PromoProductBonus {
  id              String @id @default(uuid())
  name            String
  price           Int
  quantity        Int
  subTotal        Int

  promoId         String
  promo           Promo @relation("PromoToPromoProductBonus", fields: [promoId], references: [id])
  productId       String
  product         Product @relation("ProductToPromoProductBonus", fields: [productId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([promoId])
  @@index([productId])
}

enum PromoStatus {
  archive
  active
}